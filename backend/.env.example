# Copia este archivo como backend/.env y completa DATABASE_URL sin publicar credenciales.
APP_NAME=Arbigen API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:4200"]
DATABASE_URL=
# Opcional: URL directa para Alembic cuando la aplicación usa un pooler.
DATABASE_MIGRATION_URL=
MERCADO_LIBRE_ACCESS_TOKEN=
# Selección de la fuente: auto usa Apify si APIFY_API_TOKEN existe; si no, API oficial.
MARKETPLACE_SEARCH_PROVIDER=auto
MAX_PRODUCTS_PER_ANALYSIS=200
APIFY_API_TOKEN=
APIFY_ACTOR_ID=karamelo/mercadolibre-scraper-espanol-castellano
APIFY_MAX_PAGES=4
APIFY_REQUEST_TIMEOUT_SECONDS=120
# Reservadas para fases futuras; el backend todavía no usa estos servicios.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
IMAGE_STORAGE_URL=
IMAGE_STORAGE_TOKEN=
