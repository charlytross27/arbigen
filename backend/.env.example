# Copia este archivo como backend/.env y completa DATABASE_URL sin publicar credenciales.
APP_NAME=Arbigen API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
# Código privado de 24+ caracteres para crear cuentas; guardarlo también en arbigen-api Production.
AUTH_REGISTRATION_CODE=
DATABASE_URL=
# Opcional: URL directa para Alembic cuando la aplicación usa un pooler.
DATABASE_MIGRATION_URL=
MERCADO_LIBRE_ACCESS_TOKEN=
# Selección de la fuente: auto usa Apify si APIFY_API_TOKEN existe; si no, API oficial.
MARKETPLACE_SEARCH_PROVIDER=auto
MAX_PRODUCTS_PER_ANALYSIS=200
APIFY_API_TOKEN=
APIFY_ACTOR_ID=karamelo/mercadolibre-scraper-espanol-castellano
APIFY_MAX_PAGES=4
APIFY_REQUEST_TIMEOUT_SECONDS=120
# Solo en backend: la clave no debe incluirse en Angular.
OPENAI_API_KEY=
# Vacío usa gpt-image-2.5-sunburst; se puede cambiar por otro modelo compatible.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_TIMEOUT_SECONDS=180
# Almacenamiento persistente de imágenes: pendiente de integrar.
IMAGE_STORAGE_URL=
IMAGE_STORAGE_TOKEN=
