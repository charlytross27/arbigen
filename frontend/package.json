{
  "name": "arbigen-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --configuration development",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test:simulator": "node --experimental-strip-types src/app/features/opportunity/profitability.test.mjs",
    "test:analysis": "node --experimental-strip-types src/app/features/analysis/saved-analysis-charts.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "piscina": "5.3.2"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.3"
  }
}
