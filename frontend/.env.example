# Angular CLI no carga archivos .env automáticamente.
# En desarrollo, npm start usa proxy.conf.json para enviar /api al backend local.
# En el proyecto frontend de Vercel, configura ARBIGEN_API_ORIGIN con el
# origen HTTPS público del backend, sin ruta ni barra final.
ARBIGEN_API_ORIGIN=
# No coloques credenciales de PostgreSQL ni claves privadas en el frontend.
